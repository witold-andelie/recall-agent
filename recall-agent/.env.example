# CockroachDB (PostgreSQL wire protocol)
DATABASE_URL=postgresql://user:password@host:26257/defaultdb?sslmode=verify-full

# AI provider: "bedrock" | "openai" (OpenAI-compatible gateway)
AI_PROVIDER=openai

# OpenAI-compatible (OpenCode Zen Go / OpenAI / any gateway)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
CHAT_MODEL=deepseek-v4-flash
# Embeddings: "local" | "openai" | "bedrock"
# Use local when the chat gateway has no /embeddings endpoint
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-hash
EMBEDDING_DIMS=1024

# Amazon Bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Prefer inference-profile IDs (us.*). On-demand Claude 3.x IDs are often EOL.
BEDROCK_CHAT_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Fallback: amazon.nova-lite-v1:0
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

# Session cookie signing (any long random string)
SESSION_SECRET=change-me-in-production

# Optional: read-only MCP (recall_analyst). Never the app DATABASE_URL.
# MCP_DATABASE_URL=postgresql://recall_analyst:password@host:26257/defaultdb?sslmode=verify-full
