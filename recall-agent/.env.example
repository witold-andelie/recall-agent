# Copy to .env.local. Do not commit secrets.

DATABASE_URL=postgresql://user:pass@host:26257/defaultdb?sslmode=verify-full
DATABASE_SSL=true
SESSION_SECRET=change-me-in-production

AI_PROVIDER=bedrock
AWS_REGION=us-east-1
BEDROCK_CHAT_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
EMBEDDING_DIMS=1024

# Per-process pg pool. Total CRDB sessions ≈ instances × DATABASE_POOL_MAX.
# Official CRDB guidance: stay well below cluster connection budget.
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_MS=30000
DATABASE_POOL_CONNECT_MS=10000

# Concurrent embed+stream+extract loops on this process.
# 3 instances × 24 ≈ 72 in-flight chats; extras wait then 503.
CHAT_MAX_INFLIGHT=32
CHAT_SLOT_WAIT_MS=15000

# Distinct per replica so /api/health and logs can tell nodes apart.
INSTANCE_ID=local

# Public origin for Google OAuth redirects (required in production behind a proxy).
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
